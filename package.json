{
    "name": "pg-wrapper",
    "version": "0.1.0",
    "description": "PostgreSQL connector/wrapper resource for FXServer (FiveM/RedM), with named parameters, transactions, and an in-game query stats overlay.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/elempius/pg-wrapper.git"
    },
    "private": true,
    "scripts": {
        "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node16 --outfile=dist/server.js",
        "build:client": "esbuild src/client/main.ts --bundle --platform=browser --target=es2020 --outfile=dist/client.js",
        "build": "npm run build:server && npm run build:client",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "test:build": "esbuild test/params.test.ts --bundle --platform=node --format=cjs --outfile=.test-build/params.test.js",
        "test": "npm run test:build && node --test .test-build/params.test.js",
        "format": "prettier --write \"src/**/*.ts\" \"web/*.{js,css}\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"web/*.{js,css}\" \"test/**/*.ts\""
    },
    "dependencies": {
        "pg": "^8.13.0"
    },
    "devDependencies": {
        "@citizenfx/client": "^2.0.32561-1",
        "@citizenfx/server": "^2.0.32561-1",
        "@types/node": "^22.20.1",
        "@types/pg": "^8.20.0",
        "esbuild": "^0.24.0",
        "prettier": "^3.9.6",
        "typescript": "^5.6.0"
    }
}
